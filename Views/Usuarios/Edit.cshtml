@model SistemaGimnasio.Models.Usuario

@{
    ViewData["Title"] = "Editar usuario";
}

<h1>Editar usuario</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.IdUsuario" method="post">

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <input asp-for="Usuario1" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Nueva contraseña</label>
        <input type="password" name="contrasena" class="form-control" />
        <small>Dejar en blanco para mantener la contraseña actual.</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Rol</label>
        <select asp-for="IdRol" asp-items="ViewBag.IdRol"
                class="form-select" required>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>

    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>
