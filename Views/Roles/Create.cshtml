@model SistemaGimnasio.Models.Role

@{
    ViewData["Title"] = "Crear rol";
}

<h1>Crear rol</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="NombreRol" class="form-label">
            Nombre del rol
        </label>

        <input asp-for="NombreRol" class="form-control" required />

        <span asp-validation-for="NombreRol" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>

    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>
