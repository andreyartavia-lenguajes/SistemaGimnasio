@model SistemaGimnasio.Models.PlanesMembresium

@{
    ViewData["Title"] = "Editar plan";
}

<h1>Editar plan de membresía</h1>

<form asp-action="Edit" asp-route-id="@Model.IdPlan" method="post">

    <input type="hidden" asp-for="IdPlan" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">
            Nombre del plan
        </label>

        <input asp-for="Nombre" class="form-control" required />

        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Precio" class="form-label">
            Precio en colones
        </label>

        <input asp-for="Precio" type="number" step="0.01"
               min="0.01" class="form-control" required />

        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DuracionDias" class="form-label">
            Duración en días
        </label>

        <input asp-for="DuracionDias" type="number"
               min="1" class="form-control" required />

        <span asp-validation-for="DuracionDias" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>

    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>
